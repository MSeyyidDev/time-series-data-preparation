# ---------------------------------------------------------------------------
# Time Series Data Preparation — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Input data path (used when running outside Docker)
TSDATAPREP_INPUT=data/raw/XAUUSD_M1.csv

# Output directory (used when running outside Docker)
TSDATAPREP_OUTPUT=data/processed

# Default cleaning scope: clean_5y | extended | both
TSDATAPREP_SCOPE=both

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# DuckDB file path (relative to project root)
TSDATAPREP_DUCKDB=data/processed/xauusd.duckdb

# Optional: override per-year spread percentile threshold (default 99)
# SPREAD_PERCENTILE=99

# Optional: override return-explosion MAD multiplier (default 8)
# RETURN_MAD_MULTIPLIER=8
