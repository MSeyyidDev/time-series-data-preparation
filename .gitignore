# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
env/
venv/
ENV/
.env
.env.*
!.env.example

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Type checking / linting
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
*.ipynb

# Data - never commit large raw or processed data files
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Binary output formats
*.duckdb
*.duckdb.wal
*.parquet
# Whitelist small Parquet samples shipped with the demo site
!site/data/*.parquet

# Generated reports
reports/figures/*.png
reports/figures/*.svg
reports/*.html
reports/*.json
# Whitelist demo-site figures (small, web-optimized copies)
!site/figures/*.png

# Secrets
secrets.json
credentials.json
